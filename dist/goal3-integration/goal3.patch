+    root: &Utf8Path,
+    dictionary: &plist::Dictionary,
+    context: &str,
+    key: &str,
+    expected: &str,
+) -> Result<(), ArtifactError> {
+    let actual = required_plist_string(root, dictionary, key, context)?;
+    if actual != expected {
+        return invalid_apple_bundle(
+            root,
+            format!("{context} `{key}` is `{actual}`, expected `{expected}`"),
+        );
