+fn downloaded_manifest(
+    manifest: &rustferry_remote::ArtifactManifest,
+) -> rustferry_remote::ArtifactManifest {
+    let mut downloaded = manifest.clone();
+    downloaded
+        .validation_levels
+        .insert(ValidationLevel::DownloadedToClient);
+    downloaded
