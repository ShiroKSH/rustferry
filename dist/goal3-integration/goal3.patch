+    /// # Panics
+    ///
+    /// This cannot panic because both constants satisfy the constructor bounds.
+    pub fn secure_defaults() -> Self {
+        Self::new(1_440, Duration::from_secs(5)).expect("constant polling policy is valid")
+    }
