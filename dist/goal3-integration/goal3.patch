+        return None;
+    }
+    let path = sdk.path.canonicalize_utf8().ok()?;
+    if !path.is_dir() || !path.starts_with(developer_dir) {
+        return None;
+    }
+    Some(IosDeviceSdk {
+        path,
+        version: sdk.version.clone(),
+        build_version: sdk.build_version.clone(),
