+            .field("stdin_len", &self.stdin.len())
+            .field(
+                "environment_names",
+                &self
+                    .environment
+                    .iter()
+                    .map(|pair| &pair.0)
+                    .collect::<Vec<_>>(),
+            )
+            .field("timeout", &self.timeout)
+            .finish()
+    }
+}
