+fn plist_value_is_empty(value: &plist::Value) -> bool {
+    match value {
+        plist::Value::String(value) => value.trim().is_empty(),
+        plist::Value::Array(value) => value.is_empty(),
+        plist::Value::Dictionary(value) => value.is_empty(),
+        _ => false,
+    }
+}
