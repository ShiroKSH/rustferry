+fn validate_plist_identity(
+    root: &Utf8Path,
+    dictionary: &plist::Dictionary,
+    context: &str,
+    bundle_identifier: &str,
+    app_version: &str,
+    build_number: &str,
+) -> Result<(), ArtifactError> {
