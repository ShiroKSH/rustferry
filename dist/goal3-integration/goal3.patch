+        " # v5\n        with:\n          path: |\n            ${{ env.CARGO_HOME }}/registry/index\n            ${{ env.CARGO_HOME }}/registry/cache\n            ${{ env.CARGO_HOME }}/git/db\n            ${{ env.CARGO_TARGET_DIR }}\n          key: 'rustferry-ios-${{ runner.os }}-",
+    );
+    push(yaml, config.worker.version());
+    push(
