+        let mut arguments = vec![
+            OsString::from("api"),
+            OsString::from("--hostname"),
+            OsString::from(GITHUB_HOST),
+            OsString::from("--method"),
+            OsString::from(self.method.as_str()),
+            OsString::from("-H"),
+            OsString::from(API_ACCEPT),
+            OsString::from("-H"),
+            OsString::from(API_VERSION),
