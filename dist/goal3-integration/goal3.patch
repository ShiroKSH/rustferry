+    values
+        .iter()
+        .map(|value| {
+            value.as_string().map(ToOwned::to_owned).ok_or_else(|| {
+                ArtifactError::InvalidAppleBundle {
+                    path: root.to_owned(),
+                    reason: format!("{context} `{key}` contains a non-string value"),
+                }
+            })
+        })
+        .collect()
+}
