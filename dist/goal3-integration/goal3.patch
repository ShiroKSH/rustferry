+#[derive(Clone, Debug)]
+struct CachedArtifact {
+    record: ArtifactRecord,
+    path: Utf8PathBuf,
+}
+
+#[derive(Debug)]
+struct VerifiedRun {
+    manifest: ArtifactManifest,
+    artifacts: BTreeMap<String, CachedArtifact>,
+    _cache_directory: RunCacheDirectory,
+}
