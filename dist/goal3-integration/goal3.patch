+    line(
+        yaml,
+        format_args!("{spaces}    actual=\"$(rustup run \"$RUSTUP_TOOLCHAIN\" rustc --version)\""),
+    );
+    line(
+        yaml,
+        format_args!("{spaces}    [[ \"$actual\" == \"rustc {RUST_TOOLCHAIN} \"* ]]"),
