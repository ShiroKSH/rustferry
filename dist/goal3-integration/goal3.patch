+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct UncheckedWorkerJobManifest {
+    schema_version: u32,
+    job_id: String,
+    worker_id: String,
+    provider: String,
+    request: IosDeviceBuildRequest,
+    source_input: WorkerSourceInput,
+    paths: WorkerJobPaths,
+    cleanup_policy: WorkerCleanupPolicy,
+}
