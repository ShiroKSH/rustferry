+        fn restore_search_list(&mut self) -> Result<(), KeychainError> {
+            if !self.search_list_mutated {
+                return Ok(());
+            }
+            set_search_list(&self.prior_search_list, self.options.command_timeout())?;
+            self.search_list_mutated = false;
+            Ok(())
+        }
