+    let second = plan_source_bundle(&fixture.request()).unwrap();
+
+    assert_eq!(first.manifest(), second.manifest());
+    assert_eq!(
+        paths(first.manifest()),
+        vec![
+            "Cargo.lock",
+            "Cargo.toml",
+            "app/Cargo.toml",
+            "app/src/alpha.rs",
+            "app/zeta.rs"
+        ]
+    );
+    assert!(
+        first
+            .manifest()
+            .entries
+            .iter()
+            .all(|entry| !entry.path.contains('\\'))
+    );
