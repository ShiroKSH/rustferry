+#[test]
+fn explicit_inputs_reject_cross_platform_escape_forms() {
+    let cases = [
+        ("/absolute", PortablePathReason::Absolute),
+        ("C:/Windows/System32", PortablePathReason::DrivePrefix),
+        ("//server/share", PortablePathReason::UncPrefix),
