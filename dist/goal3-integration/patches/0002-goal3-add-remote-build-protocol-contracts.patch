+    assert_eq!(serde_json::to_string(&SourceMode::Git).unwrap(), "\"git\"");
+    assert_eq!(
+        serde_json::to_string(&SourceMode::Snapshot).unwrap(),
+        "\"snapshot\""
+    );
+    assert!(SourceMode::Git < SourceMode::Snapshot);
+}
