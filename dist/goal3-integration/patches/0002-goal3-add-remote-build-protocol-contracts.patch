+/// Evidence produced by cross-platform IPA inspection.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct IpaInspection {
+    /// Main application path under `Payload/`.
