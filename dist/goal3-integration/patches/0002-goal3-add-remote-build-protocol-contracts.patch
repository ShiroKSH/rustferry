+        ("safe\\outside", PortablePathReason::Backslash),
+        ("CON/file", PortablePathReason::ReservedName),
+        ("dir/trailing.", PortablePathReason::TrailingDotOrSpace),
+        ("safe/\u{202e}hidden", PortablePathReason::InvalidCharacter),
