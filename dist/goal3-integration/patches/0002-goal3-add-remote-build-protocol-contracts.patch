+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Ferry Remote Build Protocol v1",
+  "description": "Every standalone document exchanged or persisted by protocol v1.\n\nThe generated schema is a catalog expressed as `anyOf`; transport operations still determine\nwhich concrete document is valid at each boundary.",
+  "anyOf": [
+    {
+      "description": "Client-to-provider compatibility request.",
+      "$ref": "#/$defs/HandshakeRequest"
+    },
+    {
+      "description": "Provider-to-client compatibility response.",
+      "$ref": "#/$defs/HandshakeResponse"
+    },
+    {
+      "description": "Client-to-provider readiness request.",
+      "$ref": "#/$defs/ProviderDoctorRequest"
+    },
+    {
+      "description": "Provider-to-client readiness report.",
+      "$ref": "#/$defs/ProviderDoctorReport"
+    },
+    {
+      "description": "Declarative physical-iPhone build request.",
+      "$ref": "#/$defs/IosDeviceBuildRequest"
+    },
+    {
+      "description": "Accepted provider job handle.",
+      "$ref": "#/$defs/JobHandle"
+    },
+    {
+      "description": "One NDJSON event envelope.",
+      "$ref": "#/$defs/RemoteBuildEvent"
+    },
+    {
+      "description": "Bounded event page.",
+      "$ref": "#/$defs/EventPage"
+    },
+    {
+      "description": "Event-page request.",
+      "$ref": "#/$defs/EventRequest"
+    },
+    {
+      "description": "Cancellation request.",
+      "$ref": "#/$defs/CancellationRequest"
+    },
+    {
+      "description": "Cancellation acknowledgement.",
+      "$ref": "#/$defs/CancellationAck"
+    },
+    {
+      "description": "Artifact-list request.",
+      "$ref": "#/$defs/ArtifactListRequest"
+    },
+    {
+      "description": "Artifact download request.",
+      "$ref": "#/$defs/ArtifactDownloadRequest"
+    },
+    {
+      "description": "Verified artifact download result.",
+      "$ref": "#/$defs/ArtifactDownloadResult"
+    },
+    {
+      "description": "Provider cleanup request.",
+      "$ref": "#/$defs/CleanupRequest"
+    },
+    {
+      "description": "Provider cleanup proof.",
+      "$ref": "#/$defs/CleanupConfirmation"
+    },
+    {
+      "description": "Terminal build result.",
+      "$ref": "#/$defs/IosDeviceBuildResult"
+    },
+    {
+      "description": "Persisted artifact provenance and integrity manifest.",
+      "$ref": "#/$defs/ArtifactManifest"
+    }
+  ],
+  "$defs": {
+    "AppleToolchainEvidence": {
+      "description": "Worker and Apple toolchain evidence.",
+      "type": "object",
+      "properties": {
+        "iphoneos_sdk_version": {
+          "description": "iPhoneOS SDK version selected for the job.",
+          "type": "string"
+        },
+        "rust_target": {
+          "description": "Rust target triple; physical builds require `aarch64-apple-ios`.",
+          "type": "string"
+        },
+        "rust_version": {
+          "description": "Rust compiler version.",
+          "type": "string"
+        },
+        "worker_architecture": {
+          "description": "Worker architecture.",
+          "type": "string"
+        },
+        "worker_os": {
+          "description": "Worker operating-system version.",
+          "type": "string"
+        },
+        "xcode_version": {
+          "description": "Xcode version selected for the job.",
+          "type": "string"
+        }
+      },
+      "additionalProperties": false,
+      "required": [
+        "worker_os",
+        "worker_architecture",
+        "xcode_version",
+        "iphoneos_sdk_version",
+        "rust_version",
+        "rust_target"
+      ]
+    },
