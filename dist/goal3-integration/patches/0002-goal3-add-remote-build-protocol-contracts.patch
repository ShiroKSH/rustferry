+            return Err(SigningValidationError::InvalidEntitlementValue {
+                key: None,
+                reason: EntitlementValueError::CollectionTooLarge,
+            });
+        }
+        for (key, value) in &values {
+            validate_entitlement_key(key)?;
+            validate_entitlement_value(Some(key), value, 0)?;
+        }
+        Ok(Self(values))
+    }
