+#[derive(Debug)]
+struct ArchiveSizeExceeded {
+    maximum: u64,
+    actual: u64,
+}
+
+impl fmt::Display for ArchiveSizeExceeded {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            formatter,
+            "source archive size would exceed {} bytes: {}",
+            self.maximum, self.actual
+        )
+    }
+}
