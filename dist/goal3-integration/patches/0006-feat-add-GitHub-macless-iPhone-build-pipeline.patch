+#[allow(clippy::needless_pass_by_value)] // Owned signature is a direct `map_err` adapter.
+fn io_error(operation: &'static str, source: io::Error) -> SignedIpaValidationError {
+    SignedIpaValidationError::Io {
+        operation,
+        kind: source.kind(),
+    }
+}
