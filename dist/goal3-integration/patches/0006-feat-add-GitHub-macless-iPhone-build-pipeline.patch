+#[cfg(any(target_os = "macos", test))]
+fn validate_owned_job_name(name: &str) -> bool {
+    const PREFIX: &str = "rustferry-signing-v1-";
+    let Some(token) = name.strip_prefix(PREFIX) else {
+        return false;
+    };
+    token.len() == 32
+        && token
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
