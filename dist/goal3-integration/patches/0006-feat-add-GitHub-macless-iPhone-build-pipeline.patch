+                "GitHub remote configuration\n\nRepository:\n  {}\n\nWorkflow exact:\n  {}\n\nTrusted ref:\n  {}\n\nSigning:\n  {}",
+                output.repository,
+                if output.workflow_matches { "yes" } else { "no" },
