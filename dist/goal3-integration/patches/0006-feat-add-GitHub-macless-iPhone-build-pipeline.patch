+/// Production wall clock.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct SystemProviderClock;
+
+impl ProviderClock for SystemProviderClock {
+    fn now_ms(&self) -> u64 {
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_millis()
+            .try_into()
+            .unwrap_or(u64::MAX)
