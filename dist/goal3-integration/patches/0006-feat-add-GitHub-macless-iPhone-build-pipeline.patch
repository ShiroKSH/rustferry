+        _request: &ArtifactDownloadRequest,
+    ) -> RemoteBuildResult<ArtifactDownloadResult> {
+        Err(unsupported(ProviderFeature::ArtifactDownload))
+    }
+
+    fn remove_artifacts(&mut self, _context: &GithubArtifactContext) -> RemoteBuildResult<()> {
