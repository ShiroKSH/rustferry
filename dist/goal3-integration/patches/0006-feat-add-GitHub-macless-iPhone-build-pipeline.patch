+    ) -> Result<Self, WorkerJobError> {
+        let manifest = Self {
+            schema_version: WORKER_JOB_SCHEMA_VERSION,
+            job_id: job_id.into(),
+            worker_id: worker_id.into(),
+            provider: provider.into(),
+            request,
+            source_input,
+            paths,
+            cleanup_policy,
+        };
+        manifest.validate()?;
+        Ok(manifest)
+    }
