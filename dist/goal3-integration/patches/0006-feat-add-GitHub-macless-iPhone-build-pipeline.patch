+        tool: name.to_owned(),
+        searched: vec!["PATH".to_owned()],
+        help: format!("Install `{name}` and make it available in PATH."),
+    })?;
+    found.canonicalize_utf8().map_err(|source| CliError::Io {
+        action: "resolve external tool",
+        path: found,
+        source,
