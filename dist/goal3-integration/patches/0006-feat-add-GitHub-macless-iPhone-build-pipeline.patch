+                .into_bytes()),
+                "github.signing_secrets",
+            ),
+        ];
+
+        for (name, environment, policies, secrets, expected_error) in cases {
+            let report = signed_doctor_report(environment, policies, secrets);
+            assert!(!report.ready, "accepted {name}");
