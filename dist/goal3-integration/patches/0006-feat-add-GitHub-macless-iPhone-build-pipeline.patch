+fn current_branch(git: &GitContext, reporter: &Reporter) -> Result<String, CliError> {
+    let executable = executable("git")?;
+    utf8_line(
+        &checked_git_output(
+            &executable,
+            &[
+                OsString::from("symbolic-ref"),
+                OsString::from("--quiet"),
+                OsString::from("--short"),
+                OsString::from("HEAD"),
+            ],
+            &git.root,
+            "resolve trusted Git branch",
+            reporter,
+        )?,
+        "Git branch",
+    )
+}
