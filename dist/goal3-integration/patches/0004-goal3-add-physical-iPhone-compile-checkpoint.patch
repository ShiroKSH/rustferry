+            .arg(format!("OBJROOT={intermediates}"))
+            .arg(format!("CONFIGURATION_BUILD_DIR={products}"))
+            .arg("build")
+            .current_dir(root)
+            .output()
+            .unwrap();
+        assert!(
+            build.status.success(),
