+                "the retained PKCS#12 password is not bounded safe UTF-8",
+                "Use the exact password without NUL or line-break bytes.",
+            ));
+        }
+        Ok(Self(value))
+    }
+
+    const fn as_secret(&self) -> &SecretBytes {
+        &self.0
+    }
