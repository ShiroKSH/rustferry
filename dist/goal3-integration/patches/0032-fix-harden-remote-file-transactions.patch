+        {
+            use std::os::unix::fs::PermissionsExt as _;
+            fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).map_err(|source| {
+                CliError::Io {
+                    action: "secure provider-config backup directory",
+                    path: root.clone(),
