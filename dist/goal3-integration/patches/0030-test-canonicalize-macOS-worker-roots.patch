 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/crates/rustferry-worker-macos/src/main.rs b/crates/rustferry-worker-macos/src/main.rs
index 68d2a02..a2661a3 100644
--- a/crates/rustferry-worker-macos/src/main.rs
