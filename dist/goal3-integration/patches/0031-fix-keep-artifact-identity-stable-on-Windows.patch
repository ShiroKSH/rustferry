diff --git a/crates/rustferry-github/Cargo.toml b/crates/rustferry-github/Cargo.toml
index 9d69c65..e35094d 100644
--- a/crates/rustferry-github/Cargo.toml
+++ b/crates/rustferry-github/Cargo.toml
