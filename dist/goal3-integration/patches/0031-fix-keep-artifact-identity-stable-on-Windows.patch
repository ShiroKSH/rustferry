--- a/crates/rustferry-github/src/artifact_store.rs
+++ b/crates/rustferry-github/src/artifact_store.rs
@@ -8,7 +8,7 @@ use std::{
     collections::{BTreeMap, BTreeSet, btree_map::Entry},
     error::Error,
     fmt,
-    fs::{self, File, Metadata, OpenOptions},
