 crates/rustferry-github/Cargo.toml            |  1 +
 crates/rustferry-github/src/artifact_store.rs | 50 ++++++++-----------
 3 files changed, 23 insertions(+), 29 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 13c3bf6..068b842 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1856,6 +1856,7 @@ dependencies = [
  "camino",
  "rustferry-core",
