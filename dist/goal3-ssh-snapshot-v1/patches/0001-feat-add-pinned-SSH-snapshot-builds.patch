+                },
+            );
+        }));
+        assert!(panic.is_err());
+        assert!(started.elapsed() < Duration::from_secs(1));
+        assert!(!spool_path.exists());
+        let pid = fs::read_to_string(&helper.pid).expect("helper pid");
+        let mut process_exists = true;
+        for _ in 0..20 {
