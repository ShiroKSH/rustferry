+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StrictResponseEnvelope {
+    schema_version: u32,
+    response: StrictResponse,
+}
+
+#[derive(Deserialize)]
+#[serde(
+    deny_unknown_fields,
+    rename_all = "snake_case",
+    tag = "operation",
+    content = "payload"
+)]
+enum StrictResponse {
+    Handshake(StrictHandshakeResponse),
+    ProviderDoctor(StrictProviderDoctorReport),
