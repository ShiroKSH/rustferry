+                "snapshot_build_start",
+                "source descriptor size is outside the fixed limit",
+            ));
+        }
+        validate_sha256(&self.source_descriptor_sha256, "snapshot_build_start")?;
+        validate_transfer_archive(
+            &self.source_archive,
+            MAX_WORKER_DATA_PLANE_SOURCE_BYTES,
+            "snapshot_build_start",
+        )
+    }
