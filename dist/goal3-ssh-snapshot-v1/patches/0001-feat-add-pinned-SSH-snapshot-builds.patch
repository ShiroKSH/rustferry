+fn report_created_source_bundle(
+    project: &Utf8Path,
+    workspace: &Utf8Path,
+    paths: &SourceBundleOutputPaths,
+    plan: &SourceBundlePlan,
+    path_dependencies: Vec<String>,
+    archive: SourceArchive,
+    reporter: &Reporter,
+) {
+    let output = SourceBundleCreateOutput {
