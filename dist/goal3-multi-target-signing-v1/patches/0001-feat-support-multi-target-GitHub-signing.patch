+        ),
+    );
+    line(
+        yaml,
+        format_args!(
+            "            write_record '{}' \"$RUSTFERRY_SIGNING_CERTIFICATE_PASSWORD\"",
+            config.secret_names.certificate_password.as_str()
+        ),
+    );
+    for (index, profile) in profile_names.iter().enumerate() {
+        line(
+            yaml,
+            format_args!(
+                "            write_record '{}' \"$RUSTFERRY_SIGNING_PROVISIONING_PROFILE_{}\"",
+                profile.as_str(),
+                index + 1
+            ),
+        );
+    }
+    push(yaml, "          } |\n");
